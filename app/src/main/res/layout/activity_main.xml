<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_background">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AntiGem Assistant"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_background"
            android:drawableStart="@drawable/ic_assistant_logo"
            android:drawablePadding="8dp"
            android:drawableTint="@color/color_primary" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="12sp"
            android:textColor="@color/color_secondary" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/color_outline"
        android:layout_marginVertical="8dp" />

    <!-- Chat messages container -->
    <ScrollView
        android:id="@+id/chat_messages_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/chat_messages_linear">

        </LinearLayout>
    </ScrollView>

    <!-- Input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:textSize="14sp"
            android:minLines="2"
            android:maxLines="6"
            android:background="@drawable/input_background"
            android:padding="12dp"
            android:textColor="@color/color_on_surface"
            android:textColorHint="@color/color_on_surface_variant" />

        <Button
            android:id="@+id/send_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="→"
            android:textSize="18sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
